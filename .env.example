# Environment Variables for CookCart MVP
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Database (SQLite for easy zero-config local run)
DATABASE_URL="file:./dev.db"

# REQUIRED. Session signing key for JWT-based RBAC.
# There is no built-in default: the server will refuse to start without it.
# Generate a strong value with one of:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this value invalidates all existing sessions (users must log in again).
JWT_SECRET=""

# AI Provider API Keys (Optional - the built-in offline engine is used when empty)
# These are server-only. Do NOT prefix them with NEXT_PUBLIC_.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Live Recipe Catalogue (Optional - the built-in local engine is used when empty)
# Spoonacular supplies real recipes with real cooking steps and a photo of that
# exact dish. Server-only: a NEXT_PUBLIC_ prefix would ship the key to every
# browser. Get a free key at https://spoonacular.com/food-api
# Free tier is 150 points/day and one recipe search costs 1 point, so a 6-hour
# cache is applied per ingredient/cuisine combination to avoid repeat spending.
SPOONACULAR_API_KEY=""

# Dish Photos (Optional - no key or signup required either way)
# Default behaviour resolves a real dish photo from TheMealDB, which is free and
# keyless. Nothing needs to be configured for photos to work.
#
# Set to "true" to use Pollinations (free, keyless AI image generation) as the
# fallback instead of a curated stock photo when TheMealDB has no match. Only
# the URL is generated here; the image is fetched by the browser, so this has no
# effect on server cost. It is opt-in and off by default because generation
# takes several seconds, unlike a stock-photo redirect.
ENABLE_AI_IMAGES="false"

# Application Branding
NEXT_PUBLIC_APP_NAME="CookCart"
NEXT_PUBLIC_DEFAULT_CURRENCY="HKD"
